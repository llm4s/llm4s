//| mill-version: 1.3.1
//| mill-jvm-version: 21
// The Mill quick start (docs/getting-started/mill.md): a first LLM4S call, and a test of it that needs no model,
// network or API key. `./mill app.run` runs it, `./mill app.test` tests it. CI builds it against Maven Central
// (.github/workflows/mill-quickstart.yml); scripts/check-mill-quickstart.sh keeps llm4sVersion the latest release.
package build

import mill.*, scalalib.*

// One version for every llm4s module: they are released together. (Or import llm4s-bom with `bomMvnDeps`.)
val llm4sVersion = "0.5.1"

object app extends ScalaModule {
  def scalaVersion = "3.7.1"

  def mvnDeps = Seq(
    mvn"org.llm4s::llm4s-core:$llm4sVersion",
    // llm4s-core ships no provider: add the module of each provider you use, and drop the other.
    mvn"org.llm4s::llm4s-openai:$llm4sVersion",
    mvn"org.llm4s::llm4s-ollama:$llm4sVersion",
    // llm4s-core ships no logging backend either; app/resources/logback.xml configures this one.
    mvn"ch.qos.logback:logback-classic:1.5.34"
  )

  object test extends ScalaTests, TestModule.Munit {
    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.3.6",
      mvn"org.llm4s::llm4s-testkit:$llm4sVersion"
    )
  }
}
