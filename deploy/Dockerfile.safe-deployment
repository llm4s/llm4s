# Multi-stage build for LLM4S Safe Deployment Service (issue #846).
# Build: sbt samples/stage; runtime: JRE + staged bin/lib.

FROM eclipse-temurin:21-jdk AS builder
WORKDIR /app
COPY project project
COPY modules modules
COPY build.sbt ./
ENV SBT_OPTS="-Xmx2g -Xms512m"
RUN sbt -batch "samples/stage"

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=builder /app/modules/samples/target/universal/stage ./
EXPOSE 8080
ENV PORT=8080
CMD ["/app/bin/safe-deployment-service"]
