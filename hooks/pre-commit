#!/bin/bash

# Git pre-commit hook for LLM4S project
# Smart hook that only checks affected subprojects instead of running a full build.
# Compatible with bash 3.2+ (macOS default).

set -e

# ── String-based set helpers (bash 3.2 compatible) ──────────────────────────
# These replace bash 4+ associative arrays with space-delimited strings.

set_add() {
  local varname="$1" key="$2"
  local current
  eval "current=\$$varname"
  case " $current " in
    *" $key "*) ;;
    *) eval "$varname=\"\${$varname:+\$$varname }\$key\"" ;;
  esac
}

set_contains() {
  local varname="$1" key="$2"
  local current
  eval "current=\$$varname"
  case " $current " in
    *" $key "*) return 0 ;;
    *) return 1 ;;
  esac
}

set_is_empty() {
  local varname="$1"
  local current
  eval "current=\$$varname"
  [ -z "$current" ]
}

# ── Gather staged files ──────────────────────────────────────────────────────

STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$STAGED_FILES" ]; then
  echo "No staged files — skipping pre-commit checks."
  exit 0
fi

# ── Check for build config changes → full build fallback ─────────────────────

BUILD_CONFIG_CHANGED=false
while IFS= read -r file; do
  case "$file" in
    build.sbt|project/*) BUILD_CONFIG_CHANGED=true; break ;;
  esac
done <<< "$STAGED_FILES"

if [ "$BUILD_CONFIG_CHANGED" = true ]; then
  echo "Build config changed — running full build."
  sbt scalafmtCheckAll scalafixAll compile test
  echo "All pre-commit checks passed!"
  exit 0
fi

# ── Check if any Scala files changed ─────────────────────────────────────────

HAS_SCALA=false
while IFS= read -r file; do
  case "$file" in
    *.scala) HAS_SCALA=true; break ;;
  esac
done <<< "$STAGED_FILES"

if [ "$HAS_SCALA" = false ]; then
  echo "No Scala files changed — skipping pre-commit checks."
  exit 0
fi

# ── Map staged files to subprojects ──────────────────────────────────────────

# Sets: projects with ANY change (for scalafmt + compile)
#        projects with SOURCE changes (for downstream propagation)
#        projects with TEST changes (for running tests)
PROJECT_CHANGED=""
PROJECT_SRC=""
PROJECT_TEST=""

# Generated from build.sbt: every project with sources, keyed by its directory. Longer paths
# come first so a nested module (modules/providers/voyage) wins over any prefix. A new module
# must be added here - a staged Scala file under modules/ that maps to nothing fails the hook
# rather than skipping it (see below).
map_file_to_project() {
  local file="$1"
  case "$file" in
    modules/workspace/workspaceSamples/*) echo "workspaceSamples" ;;
    modules/workspace/workspaceShared/*)  echo "workspaceShared" ;;
    modules/workspace/workspaceClient/*)  echo "workspaceClient" ;;
    modules/workspace/workspaceRunner/*)  echo "workspaceRunner" ;;
    modules/spring-boot-starter/*)        echo "springBootStarter" ;;
    modules/deploy-service/*)             echo "deployService" ;;
    modules/llm4s-effect/*)               echo "llm4sEffect" ;;
    modules/llm4s-zio/*)                  echo "llm4sZio" ;;
    modules/java-api/*)                   echo "javaApi" ;;
    modules/observability-prometheus/*)   echo "observabilityPrometheus" ;;
    modules/knowledgegraph-neo4j/*)       echo "knowledgegraphNeo4j" ;;
    modules/trace-opentelemetry/*)        echo "traceOpentelemetry" ;;
    modules/openai-compatible/*)          echo "openaiCompatible" ;;
    modules/provider-testkit/*)           echo "providerTestkit" ;;
    modules/providers/bedrock/*)          echo "bedrock" ;;
    modules/providers/watsonx/*)          echo "watsonx" ;;
    modules/providers/jina/*)             echo "jina" ;;
    modules/providers/voyage/*)           echo "voyage" ;;
    modules/gradle-demo/*)                echo "gradleDemo" ;;
    modules/memory-postgres/*)            echo "memoryPostgres" ;;
    modules/knowledgegraph/*)             echo "knowledgegraph" ;;
    modules/config-policy/*)              echo "configPolicy" ;;
    modules/observability/*)              echo "observability" ;;
    modules/agent-tools/*)                echo "agentTools" ;;
    modules/benchmarks/*)                 echo "benchmarks" ;;
    modules/anthropic/*)                  echo "anthropic" ;;
    modules/samples/*)                    echo "samples" ;;
    modules/memory/*)                     echo "memory" ;;
    modules/speech/*)                     echo "speech" ;;
    modules/ollama/*)                     echo "ollama" ;;
    modules/gemini/*)                     echo "gemini" ;;
    modules/openai/*)                     echo "openai" ;;
    modules/media/*)                      echo "media" ;;
    modules/image/*)                      echo "image" ;;
    modules/agent/*)                      echo "agent" ;;
    modules/core/*)                       echo "core" ;;
    modules/rag/*)                        echo "rag" ;;
    modules/mcp/*)                        echo "mcp" ;;
    modules/it/*)                         echo "it" ;;
    *) echo "" ;;
  esac
}

is_test_file() {
  local file="$1"
  case "$file" in
    */src/test/*) return 0 ;;
    *) return 1 ;;
  esac
}

UNMAPPED=""
while IFS= read -r file; do
  case "$file" in
    *.scala)
      proj=$(map_file_to_project "$file")
      case "$file" in
        modules/*) [ -z "$proj" ] && UNMAPPED="${UNMAPPED:+$UNMAPPED }$file" ;;
      esac
      if [ -n "$proj" ]; then
        set_add PROJECT_CHANGED "$proj"
        if is_test_file "$file"; then
          set_add PROJECT_TEST "$proj"
        else
          set_add PROJECT_SRC "$proj"
        fi
      fi
      ;;
  esac
done <<< "$STAGED_FILES"

# A module the hook does not know would otherwise be skipped silently - which is how every module
# carved from core between slices 1 and 7 went unchecked (#1252).
if [ -n "$UNMAPPED" ]; then
  echo "Error: hooks/pre-commit maps no sbt project to: $UNMAPPED"
  echo "Add the module to map_file_to_project and propagate_downstream in hooks/pre-commit."
  exit 1
fi

if set_is_empty PROJECT_CHANGED; then
  echo "No Scala files in known subprojects — skipping pre-commit checks."
  exit 0
fi

# ── Downstream compile propagation ───────────────────────────────────────────
# When a project changes, its dependents must still compile - main and test code. A test-source
# change counts too: dependents on `test->test` (most carved modules) use core's test fixtures.

DOWNSTREAM_COMPILE=""

# Generated from build.sbt: for each project, every project that depends on it, directly or
# transitively, in any configuration - a Test-scoped edge (observability -> agent % Test) can
# break a dependent's tests just as a compile edge breaks its main code. `docs` is left out: it
# has no sources of its own and is built by CI's ScalaDoc job.
propagate_downstream() {
  local proj="$1"
  case "$proj" in
    javaApi)
      set_add DOWNSTREAM_COMPILE springBootStarter
      ;;
    llm4sEffect)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      ;;
    llm4sZio)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      ;;
    media)
      set_add DOWNSTREAM_COMPILE rag
      set_add DOWNSTREAM_COMPILE image
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      set_add DOWNSTREAM_COMPILE benchmarks
      ;;
    core)
      set_add DOWNSTREAM_COMPILE knowledgegraph
      set_add DOWNSTREAM_COMPILE rag
      set_add DOWNSTREAM_COMPILE memory
      set_add DOWNSTREAM_COMPILE memoryPostgres
      set_add DOWNSTREAM_COMPILE mcp
      set_add DOWNSTREAM_COMPILE speech
      set_add DOWNSTREAM_COMPILE image
      set_add DOWNSTREAM_COMPILE ollama
      set_add DOWNSTREAM_COMPILE gemini
      set_add DOWNSTREAM_COMPILE anthropic
      set_add DOWNSTREAM_COMPILE openaiCompatible
      set_add DOWNSTREAM_COMPILE voyage
      set_add DOWNSTREAM_COMPILE bedrock
      set_add DOWNSTREAM_COMPILE watsonx
      set_add DOWNSTREAM_COMPILE jina
      set_add DOWNSTREAM_COMPILE openai
      set_add DOWNSTREAM_COMPILE workspaceClient
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE configPolicy
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE observability
      set_add DOWNSTREAM_COMPILE observabilityPrometheus
      set_add DOWNSTREAM_COMPILE traceOpentelemetry
      set_add DOWNSTREAM_COMPILE agent
      set_add DOWNSTREAM_COMPILE agentTools
      set_add DOWNSTREAM_COMPILE knowledgegraphNeo4j
      set_add DOWNSTREAM_COMPILE gradleDemo
      set_add DOWNSTREAM_COMPILE providerTestkit
      set_add DOWNSTREAM_COMPILE it
      set_add DOWNSTREAM_COMPILE benchmarks
      set_add DOWNSTREAM_COMPILE javaApi
      set_add DOWNSTREAM_COMPILE llm4sEffect
      set_add DOWNSTREAM_COMPILE llm4sZio
      set_add DOWNSTREAM_COMPILE springBootStarter
      set_add DOWNSTREAM_COMPILE deployService
      ;;
    knowledgegraph)
      set_add DOWNSTREAM_COMPILE rag
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE knowledgegraphNeo4j
      set_add DOWNSTREAM_COMPILE it
      set_add DOWNSTREAM_COMPILE benchmarks
      ;;
    rag)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      set_add DOWNSTREAM_COMPILE benchmarks
      ;;
    memory)
      set_add DOWNSTREAM_COMPILE memoryPostgres
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      ;;
    memoryPostgres)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      ;;
    mcp)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      ;;
    speech)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      ;;
    image)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      ;;
    ollama)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE configPolicy
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      set_add DOWNSTREAM_COMPILE javaApi
      set_add DOWNSTREAM_COMPILE springBootStarter
      set_add DOWNSTREAM_COMPILE deployService
      ;;
    gemini)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE configPolicy
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      set_add DOWNSTREAM_COMPILE javaApi
      set_add DOWNSTREAM_COMPILE springBootStarter
      set_add DOWNSTREAM_COMPILE deployService
      ;;
    anthropic)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE configPolicy
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      set_add DOWNSTREAM_COMPILE javaApi
      set_add DOWNSTREAM_COMPILE springBootStarter
      set_add DOWNSTREAM_COMPILE deployService
      ;;
    openaiCompatible)
      set_add DOWNSTREAM_COMPILE rag
      set_add DOWNSTREAM_COMPILE openai
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE configPolicy
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      set_add DOWNSTREAM_COMPILE benchmarks
      set_add DOWNSTREAM_COMPILE javaApi
      set_add DOWNSTREAM_COMPILE springBootStarter
      set_add DOWNSTREAM_COMPILE deployService
      ;;
    bedrock)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE configPolicy
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      ;;
    watsonx)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE configPolicy
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      ;;
    voyage)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      ;;
    jina)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      ;;
    openai)
      set_add DOWNSTREAM_COMPILE rag
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE configPolicy
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      set_add DOWNSTREAM_COMPILE benchmarks
      set_add DOWNSTREAM_COMPILE javaApi
      set_add DOWNSTREAM_COMPILE springBootStarter
      set_add DOWNSTREAM_COMPILE deployService
      ;;
    workspaceShared)
      set_add DOWNSTREAM_COMPILE workspaceClient
      set_add DOWNSTREAM_COMPILE workspaceRunner
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      ;;
    workspaceClient)
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      ;;
    workspaceRunner)
      set_add DOWNSTREAM_COMPILE workspaceSamples
      ;;
    samples)
      set_add DOWNSTREAM_COMPILE workspaceSamples
      ;;
    observability)
      set_add DOWNSTREAM_COMPILE rag
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      set_add DOWNSTREAM_COMPILE benchmarks
      ;;
    observabilityPrometheus)
      set_add DOWNSTREAM_COMPILE image
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      ;;
    traceOpentelemetry)
      set_add DOWNSTREAM_COMPILE it
      ;;
    agent)
      set_add DOWNSTREAM_COMPILE rag
      set_add DOWNSTREAM_COMPILE workspaceClient
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE observability
      set_add DOWNSTREAM_COMPILE it
      set_add DOWNSTREAM_COMPILE benchmarks
      set_add DOWNSTREAM_COMPILE javaApi
      set_add DOWNSTREAM_COMPILE llm4sEffect
      set_add DOWNSTREAM_COMPILE llm4sZio
      set_add DOWNSTREAM_COMPILE springBootStarter
      ;;
    agentTools)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      ;;
    providerTestkit)
      set_add DOWNSTREAM_COMPILE rag
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      set_add DOWNSTREAM_COMPILE benchmarks
      set_add DOWNSTREAM_COMPILE ollama
      set_add DOWNSTREAM_COMPILE configPolicy
      set_add DOWNSTREAM_COMPILE gemini
      set_add DOWNSTREAM_COMPILE anthropic
      set_add DOWNSTREAM_COMPILE openaiCompatible
      set_add DOWNSTREAM_COMPILE openai
      set_add DOWNSTREAM_COMPILE voyage
      set_add DOWNSTREAM_COMPILE bedrock
      set_add DOWNSTREAM_COMPILE watsonx
      set_add DOWNSTREAM_COMPILE jina
      set_add DOWNSTREAM_COMPILE javaApi
      set_add DOWNSTREAM_COMPILE springBootStarter
      set_add DOWNSTREAM_COMPILE deployService
      ;;
    knowledgegraphNeo4j)
      set_add DOWNSTREAM_COMPILE samples
      set_add DOWNSTREAM_COMPILE workspaceSamples
      set_add DOWNSTREAM_COMPILE it
      ;;
  esac
}

for proj in $PROJECT_CHANGED; do
  propagate_downstream "$proj"
done

# ── Build the SBT command list ───────────────────────────────────────────────

SBT_CMDS=()

# 1) scalafmt check for changed projects
for proj in $PROJECT_CHANGED; do
  SBT_CMDS+=("${proj}/scalafmtCheck")
  SBT_CMDS+=("${proj}/Test/scalafmtCheck")
done

# 2) compile + test for directly changed projects
for proj in $PROJECT_CHANGED; do
  SBT_CMDS+=("${proj}/scalafix")
  SBT_CMDS+=("${proj}/compile")
  # Test if source or test files changed (source changes can break tests too)
  if set_contains PROJECT_TEST "$proj" || set_contains PROJECT_SRC "$proj"; then
    SBT_CMDS+=("${proj}/test")
  fi
done

# 3) compile (main and test) for downstream dependents that aren't already being tested
for proj in $DOWNSTREAM_COMPILE; do
  if ! set_contains PROJECT_CHANGED "$proj"; then
    SBT_CMDS+=("${proj}/Test/compile")
  fi
done

# ── Run SBT ──────────────────────────────────────────────────────────────────

echo "=== Pre-commit: affected projects ==="
echo "  Changed: $PROJECT_CHANGED"
if ! set_is_empty DOWNSTREAM_COMPILE; then
  # Show only downstream projects not already in the changed set
  EXTRA=""
  for proj in $DOWNSTREAM_COMPILE; do
    if ! set_contains PROJECT_CHANGED "$proj"; then
      EXTRA="${EXTRA:+$EXTRA }$proj"
    fi
  done
  if [ -n "$EXTRA" ]; then
    echo "  Downstream compile: $EXTRA"
  fi
fi
echo "  SBT commands: ${SBT_CMDS[*]}"
echo "======================================"

if ! command -v sbt &> /dev/null; then
  echo "Error: sbt is not installed or not in PATH"
  exit 1
fi

# Single SBT invocation with all commands
sbt "${SBT_CMDS[@]}"

echo "All pre-commit checks passed!"
